# =========================================================
# Política principal de exclusão do repositório
# Este arquivo é a fonte canônica das regras de ignore.
# =========================================================

# ---------------------------------------------------------
# R / RStudio
# ---------------------------------------------------------
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# ---------------------------------------------------------
# Python
# ---------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.python-version
.venv/
venv/
env/
ENV/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/

# ---------------------------------------------------------
# Ambientes / configurações locais
# ---------------------------------------------------------
.env
.env.*
*.local

# ---------------------------------------------------------
# Sistema operacional / editores
# ---------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# ---------------------------------------------------------
# Arquivos compactados e pacotes gerados
# ---------------------------------------------------------
*.zip
*.7z
*.tar
*.gz

# ---------------------------------------------------------
# Logs e temporários
# ---------------------------------------------------------
*.log
*.tmp
*.temp

# ---------------------------------------------------------
# Saídas geradas
# ---------------------------------------------------------
saidas/*
relatorios/*
!saidas/.gitkeep
!relatorios/.gitkeep
!relatorios/AUDITORIA_ARQUITETURAL_V3.md

# ---------------------------------------------------------
# Derivados de dados e caches
# Manter apenas arquivos canônicos quando rastreados.
# ---------------------------------------------------------
cache/
*.parquet
*.feather
*.pkl
*.joblib
*.json.bak

# ---------------------------------------------------------
# Planilhas e exportações tabulares
# Ignorar gerados por padrão.
# Arquivos canônicos rastreados continuam permitidos.
# ---------------------------------------------------------
*.csv
*.xls
*.xlsx
!dados/dados_financeiros.xlsx

# ---------------------------------------------------------
# Diretórios específicos do projeto
# ---------------------------------------------------------
dados/bruto/*
dados/intermediario/*
dados/processado/*
!dados/bruto/.gitkeep
!dados/intermediario/.gitkeep
!dados/processado/.gitkeep
